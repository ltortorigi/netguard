# Copy this file to .env and replace the password before starting.
ADMIN_PASSWORD=replace-this-with-a-strong-password
PORT=3000
# Hosts and ports the administrator is allowed to monitor (exact matches only).
ALLOWED_TARGETS=127.0.0.1:43080
CHECK_INTERVAL_MS=60000
CHECK_TIMEOUT_MS=5000
# Optional: enable MongoDB Atlas instead of local file persistence.
# MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER/
MONGODB_DB=netguard
